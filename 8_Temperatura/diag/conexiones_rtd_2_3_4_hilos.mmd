%%{init: {'theme': 'base', 'themeVariables': {'background': '#fffdf8', 'primaryColor': '#f5efe2', 'primaryTextColor': '#2b2b2b', 'primaryBorderColor': '#8b5e3c', 'lineColor': '#6b7280', 'fontFamily': 'Trebuchet MS, Verdana, sans-serif'}}}%%
flowchart LR
  subgraph A[RTD a 2 hilos]
    direction LR
    A1[Medidor] --> A2[Cable 1]
    A2 --> A3[RTD]
    A3 --> A4[Cable 2]
    A4 --> A1
    A5[Error: la resistencia del cable se suma]:::warn
  end

  subgraph B[RTD a 3 hilos]
    direction LR
    B1[Puente o transmisor] --> B2[Cable 1]
    B2 --> B3[RTD]
    B3 --> B4[Cable 2]
    B3 --> B5[Cable 3]
    B4 --> B1
    B5 --> B1
    B6[Compensa si los cables son similares]:::ok
  end

  subgraph C[RTD a 4 hilos]
    direction LR
    C1[Fuente de corriente] --> C2[Cable I+]
    C2 --> C3[RTD]
    C3 --> C4[Cable I-]
    C5[Voltimetro diferencial] --> C6[Cable V+]
    C6 --> C3
    C3 --> C7[Cable V-]
    C7 --> C5
    C8[Maxima precision de laboratorio]:::best
  end

  classDef warn fill:#f4cccc,stroke:#a61c00,stroke-width:2px,color:#1f2937;
  classDef ok fill:#fff2cc,stroke:#bf9000,stroke-width:2px,color:#1f2937;
  classDef best fill:#d9eaf7,stroke:#3d85c6,stroke-width:2px,color:#1f2937;
