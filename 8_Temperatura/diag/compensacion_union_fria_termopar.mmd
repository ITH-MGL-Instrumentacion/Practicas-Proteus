flowchart LR
  A[Union caliente]:::hot --> B[Termopar]:::tc
  B --> C[Union fria]:::cold
  C --> D[Acondicionamiento analogico]:::amp
  C --> E[NTC o sensor de referencia]:::ref
  D --> F[ADC o medidor de mV]:::meas
  E --> G[Temperatura de referencia]:::ref
  F --> H[Tabla ITS-90 o conversion]:::calc
  G --> H
  H --> I[Temperatura reconstruida de la union caliente]:::out

  J[E(Tcaliente, 0)]:::eq --> H
  K[E(Tcaliente, Tfria) + E(Tfria, 0)]:::eq --> H

  classDef hot fill:#f4cccc,stroke:#a61c00,stroke-width:2px,color:#1f2937,font-size:18px;
  classDef tc fill:#fce5cd,stroke:#b45f06,stroke-width:2px,color:#1f2937,font-size:18px;
  classDef cold fill:#fff2cc,stroke:#bf9000,stroke-width:2px,color:#1f2937,font-size:18px;
  classDef amp fill:#d9eaf7,stroke:#3d85c6,stroke-width:2px,color:#1f2937,font-size:18px;
  classDef ref fill:#e6e0f8,stroke:#674ea7,stroke-width:2px,color:#1f2937,font-size:18px;
  classDef meas fill:#d9ead3,stroke:#4f772d,stroke-width:2px,color:#1f2937,font-size:18px;
  classDef calc fill:#f9e2ef,stroke:#a64d79,stroke-width:2px,color:#1f2937,font-size:18px;
  classDef out fill:#d8ead3,stroke:#38761d,stroke-width:3px,color:#1f2937,font-size:20px;
  classDef eq fill:#ffffff,stroke:#6b7280,stroke-dasharray: 4 2,color:#1f2937,font-size:17px;
